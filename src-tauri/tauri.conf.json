{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VEX",
  "version": "0.1.0",
  "identifier": "com.sarthak.vex",
  "build": { "beforeDevCommand": "npm run dev", "beforeBuildCommand": "npm run build", "devUrl": "http://127.0.0.1:1420", "frontendDist": "../frontend/dist" },
  "app": { "windows": [{ "label": "main", "title": "VEX — The Spirit of Your Laptop", "width": 390, "height": 430, "minWidth": 260, "minHeight": 300, "resizable": true, "alwaysOnTop": true, "decorations": false, "transparent": true, "shadow": true, "visible": true }], "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' http://127.0.0.1:1420" } },
  "bundle": { "active": true, "targets": "nsis", "icon": ["icons/vex.svg"], "windows": { "nsis": { "installerMode": "currentUser", "startMenuFolder": "VEX", "shortcutName": "VEX", "createDesktopShortcut": false } } }
}
